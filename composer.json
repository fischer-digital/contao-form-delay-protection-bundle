{
    "name": "tbo/contao-form-delay-protection-bundle",
    "description": "Time-based spam protection for Contao forms using HMAC-signed timestamps",
    "keywords": ["contao", "spam", "protection", "form", "delay", "hmac", "security"],
    "type": "contao-bundle",
    "license": "MIT",
    "homepage": "https://github.com/fischer-digital/tbo-contao-form-delay-protection-bundle",
    "support": {
        "issues": "https://github.com/fischer-digital/tbo-contao-form-delay-protection-bundle/issues",
        "source": "https://github.com/fischer-digital/tbo-contao-form-delay-protection-bundle"
    },
    "authors": [
        {
            "name": "fischer-digital",
            "homepage": "https://fischerdigital.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Tbo\\FormDelayProtection\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Tbo\\FormDelayProtection\\ContaoManager\\Plugin"
    }
}
