{
    "name": "tbo/contao-form-delay-protection-bundle",
    "description": "Time-based spam protection for Contao forms. Adds a minimum delay between page load and form submission using HMAC-signed timestamps.",
    "keywords": ["contao", "spam", "protection", "form", "hmac", "delay"],
    "type": "contao-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "thebrandoffice",
            "homepage": "https://thebrandoffice.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Tbo\\FormDelayProtection\\": "src/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Tbo\\FormDelayProtection\\ContaoManager\\Plugin"
    }
}
